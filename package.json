{
  "name": "cs2-case-sim",
  "version": "0.1.0",
  "private": true,
  "description": "The Vault — CS2 Case Opening Simulator",
  "type": "module",
  "scripts": {
    "dev":             "vite",
    "build":           "vite build",
    "preview":         "vite preview",
    "test":            "vitest run",
    "test:watch":      "vitest",
    "test:ui":         "vitest --ui",
    "coverage":        "vitest run --coverage",
    "data:audit":      "node tools/catalog/audit-data.mjs",
    "docs:reference":  "node tools/catalog/generate-reference-docs.mjs",
    "docs:reference:check": "node tools/catalog/generate-reference-docs.mjs --check",
    "data:sync:cases": "node tools/catalog/sync-cases.mjs",
    "data:sync:containers": "node tools/catalog/sync-containers.mjs",
    "data:sync:translations": "node tools/catalog/sync-translations.mjs",
    "data:fetch:cologne-2026": "node tools/catalog/fetch-cologne-2026-reference.mjs",
    "data:fetch:music-kits": "node tools/catalog/fetch-music-kit-reference.mjs",
    "data:fetch:steam-prices": "node tools/catalog/fetch-steam-price-reference.mjs",
    "data:sync:steam-prices": "node tools/catalog/sync-steam-price-reference.mjs --write",
    "data:sync:market": "node tools/catalog/sync-market-reference.mjs"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "jsdom": "^25.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
